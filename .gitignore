# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Artefactos de release generados por build_release.ps1
/dist/
# Certificados de firma de desarrollo (contienen llave privada)
/certs/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secretos y simbolos de depuracion de --obfuscate (build_release.ps1)
.env
.env.*
debug_info/

# Instrucciones y skills de los agentes: LOCALES (repo publico, dueno 2026-11-14).
# Solo existe CLAUDE.md; los otros nombres quedan ignorados por si una herramienta los genera.
.claude/
CLAUDE.md
.agents/
AGENTS.md
GEMINI.md

# Worktrees de los carriles si alguien los crea dentro del repo (van en ..\SoloKey-<letra>)
/SoloKey-*/

# SoloKey: reglas anadidas por las features

# Seguridad: llaves de firma Android/iOS (NUNCA versionar)
**/key.properties
*.jks
*.keystore
*.p12
*.pepk

# Datos sensibles: bovedas exportadas / backups locales (export/import)
*.skvault
*.vgvault
*.vault

# Bases de datos locales y artefactos de pruebas (drift/sqlite)
*.sqlite
*.sqlite3
*.db
*.db-journal
vault_guard_db*

# Flutter: companion deprecado de plugins
.flutter-plugins

# iOS / CocoaPods (para cuando se agregue soporte iOS)
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/ephemeral/
# Vectores de la v1 (CAL-2): boveda DE PRUEBA, generada en Podman; la unica excepcion a las reglas de arriba.
!vectores/v1/boveda/vault_guard_db.sqlite
!vectores/v1/boveda/export.skvault
